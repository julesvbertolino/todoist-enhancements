# Apache, which is what Infomaniak serves this from.
#
# Vite copies everything in public/ into dist/ untouched, so this ships with
# the build and there is nothing to remember at upload time.

# Apache has no media type for .webmanifest and sends the file with no
# Content-Type header at all. Chromium reads it anyway; not everything does,
# and a manifest that is not recognised is an app that cannot be installed.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# The service worker must never be served from cache, or a new build sits
# behind the old one until the browser decides otherwise; nor must the theme
# boot script, which has no hash in its name. Everything under assets/
# carries a content hash in its name and can be kept forever.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|registerSW\.js|theme-boot\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# What the page may load and where it may talk to.
#
# The Todoist token sits in this origin's storage, and the app renders
# descriptions and comments other people wrote. The Markdown renderer escapes
# all of it, but if anything ever slipped through, this is what stops it from
# running a script or sending the token anywhere but Todoist.
#
#   script-src   Only this site's own files. No inline script anywhere:
#                the theme boot script is a file (theme-boot.js) for that.
#   style-src    The stylesheet, plus inline styles: React sets project
#                colours, the custom accent and the swipe offset inline.
#   connect-src  This site and the Todoist API — nothing else can be fetched.
#   img-src      Avatars and workspace logos come from Todoist's CDNs and
#                the author's from GitHub, on hosts that are not fixed, so any
#                HTTPS image is allowed. An image cannot run anything.
#
# Keep in step with `preview.headers` in vite.config.ts, which applies the
# same policy to `npm run preview` so it can be checked before uploading.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.todoist.com; img-src 'self' data: blob: https:; font-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# A single-page app behind a hash router still has exactly one document. A
# request for a path that is not a real file is that document, not a 404 —
# which is also what stops a mistyped URL returning the host's error page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
